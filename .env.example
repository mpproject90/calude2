# Copy to .env and fill in. NEVER commit .env.
# .env is gitignored — keep it that way.

# Burner wallet private key (base58). Phase 3 only. Leave blank until then.
WALLET_PRIVATE_KEY=

# Solana RPC endpoint
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional data provider keys
BIRDEYE_API_KEY=

# Live trading kill flag. Must be exactly "true" to enable real swaps.
# Any other value (or absent) = paper/backtest only.
LIVE_TRADING=false
