# Secrets — never commit.
# These are deliberately UNANCHORED: a secret nested anywhere is still a secret,
# so matching at any depth is the desired behaviour here.
.env
.env.*
!.env.example
*.pem
*.key
wallet.json
keypair.json

# Runtime data
# Leading slashes matter: a bare `data/` also matches src/data/, which silently
# excluded the entire data layer from the repo until a clean-clone test caught
# it. Anchor anything that is only meant to exist at the repo root.
/data/
*.db
*.db-journal
*.db-wal
*.db-shm
/logs/
*.log

# *.db and *.log above match at ANY depth, which would silently swallow a
# committed test fixture — the same failure mode as the `data/` bug. Test
# fixtures are explicitly re-included. (Secrets are NOT re-included: the
# patterns above still win for .env, keys and wallets under test/.)
!test/fixtures/*.db
!test/fixtures/*.log

# Build / deps
node_modules/
/dist/
/coverage/
.tsbuildinfo

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
